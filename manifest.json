{
  "manifest_version": 3,
  "name": "DeepAns Extension",
  "version": "1.0",
  "description": "Send selected text to a neural network API and view the response in a modal window.",
  "permissions": ["contextMenus", "scripting", "activeTab","storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
     "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"],
      "type": "module"
 
    }
  ]
}
